#!/bin/sh
set -eu
if [ "${1:-}" = remove ] || [ "${1:-}" = deconfigure ]; then
  if command -v systemctl >/dev/null 2>&1; then
    systemctl stop dragonegg-sdrmm-ui.service dragonegg-rtltcp-bridge.service >/dev/null 2>&1 || true
    systemctl disable dragonegg-sdrmm-ui.service dragonegg-rtltcp-bridge.service >/dev/null 2>&1 || true
  fi
fi
exit 0
